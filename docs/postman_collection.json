{
	"info": {
		"_postman_id": "b3e04746-d87a-4ec6-894c-e8d0e7223604",
		"name": "UTS P1 - Notes API (Satirical Notebook)",
		"description": "API collection for UTS P1 Notes application. Covers Sanctum authentication and authenticated Note CRUD.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"critic@example.com\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Authenticate user and store bearer token in collectionVariables."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Revoke current access token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Notes",
			"item": [
				{
					"name": "List Notes",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/notes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notes"
							]
						},
						"description": "List all notes belonging to the authenticated user."
					},
					"response": []
				},
				{
					"name": "Store Note",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var data = pm.response.json();",
									"    if (data && data.id) {",
									"        pm.collectionVariables.set('note_id', data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Birokrasi Perizinan Lambat\",\n  \"content\": \"Mengurus surat rekomendasi memakan waktu lebih dari tiga bulan tanpa kepastian rincian prosedur.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/notes",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notes"
							]
						},
						"description": "Create a new satirical note."
					},
					"response": []
				},
				{
					"name": "Show Note",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/notes/{{note_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Fetch a specific note by ID."
					},
					"response": []
				},
				{
					"name": "Update Note",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Birokrasi Perizinan Masih Lambat\",\n  \"content\": \"Tambahan berkas rangkap empat diminta lagi di meja verifikasi berikutnya.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/notes/{{note_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Update title and content of the note."
					},
					"response": []
				},
				{
					"name": "Destroy Note",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/notes/{{note_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Delete a note by ID."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "note_id",
			"value": "1",
			"type": "string"
		}
	]
}
